      "name": "GitHub - Search Trending Repos"
    },
    {
      "parameters": {
        "jsCode": "const repos = $input.first().json.items || [];\nconst top5 = repos\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)\n  .slice(0, 5)\n  .map(r => ({\n    name: r.name,\n    full_name: r.full_name,\n    owner: r.owner.login,\n    html_url: r.html_url,\n    description: r.description,\n    stars: r.stargazers_count,\n    language: r.language\n  }));\nreturn top5.map(r => ({ json: r }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "9288adab-3e0a-4474-84ee-79bed2ac413d",
      "name": "Filter Top 5 by Stars"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.full_name }}/readme",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        0
      ],
      "id": "fb0e20d0-5488-454a-b17b-e38a692acab3",
      "name": "GitHub - Fetch README (Enrich)",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const enriched = $input.all();\nconst original = $('Filter Top 5 by Stars').all();\nconst results = [];\nfor (let i = 0; i < enriched.length; i++) {\n  const readme = (enriched[i].json.data || '').toString().slice(0, 300);\n  const merged = Object.assign({}, original[i].json, { readme_excerpt: readme });\n  results.push({ json: merged });\n}\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -96
      ],
      "id": "b3990e24-4e02-4edf-9720-bde42f0c911e",
      "name": "Merge README into Repo Data"
    },
    {
      "parameters": {
        "jsCode": "const failed = $input.all();\nconst original = $('Filter Top 5 by Stars').all();\nconst results = [];\nfor (let i = 0; i < failed.length; i++) {\n  const errMsg = (failed[i].json.error || failed[i].json.message || 'unknown error').toString();\n  const base = original[i] ? original[i].json : {};\n  const merged = Object.assign({}, base, { readme_excerpt: 'README fetch failed: ' + errMsg });\n  results.push({ json: merged });\n}\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
