    {
      "parameters": {
        "jsCode": "const items = $input.all();\nfunction esc(s) {\n  return (s || '').toString()\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\nlet rows = '';\nfor (const item of items) {\n  const r = item.json;\n  rows += '<tr><td style=\"padding:8px;border-bottom:1px solid #eee;\">' +\n    '<b>' + esc(r.full_name) + '</b> (' + r.stars + ' stars) - ' + esc(r.tier) + '<br/>' +\n    '<span style=\"color:#555;\">' + esc(r.description) + '</span><br/>' +\n    '<a href=\"' + r.html_url + '\">' + r.html_url + '</a><br/>' +\n    '<small>' + esc(r.readme_excerpt).slice(0, 200) + '...</small>' +\n    '</td></tr>';\n}\nconst html = '<h2>Daily GitHub Automation Digest</h2><table style=\"width:100%;border-collapse:collapse;\">' + rows + '</table>';\nreturn [{ json: { html, itemCount: items.length } }];"
      },
